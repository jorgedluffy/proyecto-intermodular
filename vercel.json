{
  "version": 2,
  "builds": [
    {
      "src": "back/app.js",
      "use": "@vercel/node"
    },
    {
      "src": "front/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/home-budget/browser"
      }
    }
  ],
  "routes": [
    { "src": "/gastos(.*)", "dest": "/back/app.js" },
    { "src": "/categorias(.*)", "dest": "/back/app.js" },
    { "src": "/cargarCsv", "dest": "/back/app.js" },
    { "src": "/descargarCsv", "dest": "/back/app.js" },
    { "src": "/(.+\\..+)", "dest": "/front/$1" },
    { "src": "/(.*)", "dest": "/front/index.html" }
  ]
}
